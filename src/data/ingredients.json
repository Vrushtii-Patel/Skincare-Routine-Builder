{
  "schemaVersion": 2,
  "tags": {
    "retinoid": "Vitamin A derivatives that act on retinoid receptors (OTC retinol and adapalene; prescription tretinoin and tazarotene).",
    "retinol-alternative": "Marketed as a retinol alternative; NOT a retinoid and not assumed equivalent.",
    "aha": "Alpha hydroxy acids (chemical exfoliants).",
    "bha": "Beta hydroxy acid (salicylic acid).",
    "exfoliant": "Any chemical exfoliating acid (AHA or BHA).",
    "acne-active": "Ingredient commonly used in acne treatment.",
    "antibacterial": "Reduces acne-associated bacteria.",
    "antioxidant": "Antioxidant ingredient.",
    "brightener": "Marketed for uneven tone or pigmentation.",
    "hydrator": "Moisturising or water-binding ingredient.",
    "humectant": "Draws water into skin.",
    "soothing": "Marketed to calm skin.",
    "barrier": "Marketed to support the skin barrier.",
    "spf": "Sun-protection filters."
  },
  "fieldDefinitions": {
    "irritationPotential": "none|low|moderate|high. APPROXIMATE ingredient-level hint used only to break ties when ranking placement. It never gates safety decisions and never replaces product directions, because irritation depends on concentration, formulation and the individual.",
    "availability": "otc|rx|both. Where 'rx' or 'both', the product may carry clinician directions that override every default in this dataset.",
    "schedulingMode": "scheduled = scheduler assigns specific nights from frequencies.json. every-routine = appears in its routine slot by default but is NOT required daily; a product's own directions may reduce frequency and the scheduler enforces no minimum. user-directed = never auto-assigned; needs user- or clinician-entered directions.",
    "preferredTime": "AM|PM|any. A soft placement preference, not a rule.",
    "pregnancyAdvisory": "true = show the retinoid pregnancy/breastfeeding consult notice. false means 'no advisory shipped', NOT 'known safe'."
  },
